# Django Core Configuration
DJANGO_SECRET_KEY=replace-with-a-secure-random-string-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost,*

# Database: Uses SQLite (db.sqlite3) automatically with zero setup.
# No DB_NAME or database passwords needed!

# CORS Configuration (Set to your Vercel frontend URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# File Upload Limit (in MB)
MAX_UPLOAD_SIZE_MB=10
