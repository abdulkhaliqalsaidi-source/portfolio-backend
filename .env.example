# Django Core Configuration
DJANGO_SECRET_KEY=replace-with-a-secure-random-string-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost

# Database Configuration (PostgreSQL in Production)
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASSWORD=your_strong_database_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000

# File Upload Limit (in MB)
MAX_UPLOAD_SIZE_MB=10
